# Copy to backend/.env (never commit the real .env)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
FILE_TTL_HOURS=24
# Optional: full path to ffmpeg/ffprobe if they are not on PATH
FFPROBE_PATH=ffprobe
# Optional: full path to ffmpeg if it is not on PATH
FFMPEG_PATH=ffmpeg
# auto = GPU if PyTorch can see one, otherwise CPU. Or force: cuda / cpu
DEMUCS_DEVICE=auto
# Separate, isolated Python 3.12 RVC environment and official project checkout.
RVC_PYTHON=backend/.venv-rvc/Scripts/python.exe
RVC_PROJECT_DIR=backend/rvc-project
RVC_DEVICE=auto
# Isolated Seed-VC zero-shot runtime (source + target reference audio).
SEED_VC_PYTHON=backend/.venv-seed-vc/Scripts/python.exe
SEED_VC_PROJECT_DIR=backend/seed-vc-project
SEED_VC_DEVICE=auto
SEED_VC_DIFFUSION_STEPS=25
SEED_VC_FP16=true
# Kokoro runs in the backend environment and offloads its cached model to CPU after each job.
KOKORO_DEVICE=auto
MAX_TTS_CHARACTERS=2000
# Max length of the target speaker reference clip (seconds)
MAX_REFERENCE_SECONDS=30
PIPER_VOICE=en_US-lessac-medium
# Longest audio accepted for separation, and the maximum run time of one job
MAX_AUDIO_MINUTES=20
JOB_TIMEOUT_S=1800
